# =============================================================
# autoposter — .env.example
# Copy this file to .env and fill in every value.
# NEVER commit .env to version control.
# =============================================================

# ---- Reddit (PRAW) ------------------------------------------
# Create an app at: https://www.reddit.com/prefs/apps
# Select "script" type.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=autoposter/1.0 by u/YOUR_REDDIT_USERNAME

# ---- Discord Bot --------------------------------------------
# Create a bot at: https://discord.com/developers/applications
# Enable: bot token, applications.commands scope, bot scope
DISCORD_BOT_TOKEN=
# Channel ID to send pipeline logs/results to (right-click channel -> Copy ID)
DISCORD_LOG_CHANNEL_ID=

# ---- LLM (Google Gemini or Anthropic Claude) -----------------
# Free Gemini key at: https://aistudio.google.com/
GEMINI_API_KEY=
# Or Claude key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ---- Meta Graph API (Instagram) -----------------------------
# See README § "Meta / Instagram Setup" for step-by-step instructions.
INSTAGRAM_USER_ID=          # numeric Instagram Business/Creator user ID
INSTAGRAM_ACCESS_TOKEN=     # long-lived User Access Token (60-day expiry)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ---- Cloudflare R2 (temp video hosting) --------------------
# Bucket must have public access enabled (or a public custom domain).
# See README § "Cloudflare R2 Setup".
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=autoposter-videos
# Public base URL of your R2 bucket (e.g. https://pub-xxxx.r2.dev or your custom domain)
R2_PUBLIC_BASE_URL=

# ---- AWS S3 (alternative to R2 — leave blank if using R2) --
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1

# ---- Optional overrides -------------------------------------
# Set to "true" to skip actual Instagram posting (useful for local testing)
DRY_RUN=false
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
